---
// ============================================================
// PROMAQ MÁQUINAS - Contacto
// Ruta: /contacto/
// Canal directo: WhatsApp +54 9 11 3207-7351, tel y mail
// (pro_maq@yahoo.com.ar). Schema: LocalBusiness lo inyecta
// LayoutBase (AutoRepair); aquí se suma ContactPage.
// ============================================================
import Layout from '../layouts/LayoutBase.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';

const titulo = 'Contacto - WhatsApp, Teléfono y Formulario | PROMAQ';
const descripcion =
  'Contacto con PROMAQ MÁQUINAS: WhatsApp +54 9 11 3207-7351, teléfono, mail y formulario de consulta. Service de autoelevadores en Buenos Aires y Entre Ríos →';
const keywords =
  'contacto promaq maquinas, contacto autoelevadores buenos aires, service de autoelevadores buenos aires contacto, presupuesto autoelevadores, whatsapp autoelevadores buenos aires';

const urlPagina = 'https://www.promaqmaquinas.com.ar/contacto/';
const urlWhatsapp =
  'https://wa.me/5491132077351?text=Hola%20Emmanuel%2C%20me%20comunico%20desde%20la%20web%20para%20consultar%20sobre%20un%20servicio.';
const telefonoMostrar = '+54 9 11 3207-7351';
const telefonoTel = '+5491132077351';
const emailMostrar = 'pro_maq@yahoo.com.ar';

// Zonas de cobertura (mismo alcance que el Schema del negocio)
const zonasCobertura = [
  { '@type': 'City', name: 'Ciudad Autónoma de Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Norte del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Oeste del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Sur del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Provincia de Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Entre Ríos' },
  { '@type': 'Country', name: 'Argentina' },
];

// Chips de cobertura visibles
const zonasVisibles = [
  'Ciudad Autónoma de Buenos Aires',
  'Zona Norte GBA',
  'Zona Oeste GBA',
  'Zona Sur GBA',
  'Provincia de Buenos Aires',
  'Entre Ríos',
  'Argentina',
];

// Motivos de consulta del formulario (select)
const motivosConsulta = [
  'Service y reparación de autoelevadores',
  'Venta de filtros industriales',
  'Fabricación de filtros especiales',
  'Venta de autoelevadores',
  'Alquiler de maquinaria',
  'Otra consulta',
];

// Servicios para las tarjetas de enlace rápido
const servicios = [
  {
    href: '/reparacion-autoelevadores/',
    titulo: 'Service y reparación de autoelevadores',
    descripcion:
      'Mantenimiento preventivo y correctivo en planta o taller: frenos, transmisión, hidráulica y mástiles.',
    icono:
      '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    href: '/venta-de-filtros/',
    titulo: 'Venta de filtros industriales',
    descripcion:
      'Filtros de aire, aceite, combustible e hidráulicos, nacionales e importados, para autoelevadores y maquinaria.',
    icono: '<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>',
  },
  {
    href: '/fabricacion-filtros-especiales/',
    titulo: 'Fabricación de filtros especiales',
    descripcion:
      'Filtros a medida sobre muestra, plano o medidas específicas para maquinaria fuera de estándar.',
    icono:
      '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
  },
  {
    href: '/venta-de-autoelevadores/',
    titulo: 'Venta de autoelevadores',
    descripcion:
      'Autoelevadores nuevos y usados seleccionados, reacondicionados con garantía. Diésel, nafta, GLP y eléctricos.',
    icono:
      '<rect x="3" y="6" width="7" height="10" rx="1"/><line x1="13" y1="3" x2="13" y2="16"/><line x1="13" y1="16" x2="19" y2="16"/><circle cx="6" cy="18.5" r="2"/><circle cx="16" cy="18.5" r="2"/>',
  },
  {
    href: '/alquiler-de-maquinaria/',
    titulo: 'Alquiler de maquinaria y autoelevadores',
    descripcion:
      'Renta por día, mes o largo plazo con mantenimiento incluido. Ideal para depósitos logísticos, obras y descarga de camiones.',
    icono:
      '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  },
];

// Schema adicional: ContactPage (el LocalBusiness lo emite LayoutBase)
const schemaAdicional = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${urlPagina}#contacto`,
  url: urlPagina,
  name: 'Contacto con PROMAQ MÁQUINAS',
  description:
    'Canales de contacto de PROMAQ MÁQUINAS: WhatsApp, teléfono, correo electrónico y formulario de consulta para service de autoelevadores, filtros, venta y alquiler de maquinaria.',
  about: { '@id': 'https://www.promaqmaquinas.com.ar/#negocio' },
  inLanguage: 'es-AR',
  telephone: telefonoTel,
  email: emailMostrar,
  areaServed: zonasCobertura,
};
---

<Layout title={titulo} description={descripcion} keywords={keywords} schemaAdicional={schemaAdicional}>

  <!-- ============ Hero Section ============ -->
  <section id="inicio" class="relative overflow-hidden border-b border-zinc-800 bg-slate-900 scroll-mt-24">
    <!-- Fondo: rejilla industrial + resplandor naranja -->
    <div class="fondo-rejilla degradado-hero absolute inset-0 opacity-40" aria-hidden="true"></div>
    <div class="absolute -top-32 right-0 h-96 w-96 rounded-full bg-orange-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-yellow-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
      <div class="max-w-4xl">

        <!-- Miga de pan visible -->
        <nav aria-label="Miga de pan" class="mb-6 text-sm">
          <ol class="flex flex-wrap items-center gap-2 text-zinc-500">
            <li><a href="/" class="transition hover:text-orange-400">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-zinc-300" aria-current="page">Contacto</li>
          </ol>
        </nav>

        <!-- Badge -->
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-yellow-500/30 bg-yellow-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-yellow-400">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-yellow-400"></span>
          </span>
          Respuesta rápida · Buenos Aires, GBA y Entre Ríos
        </p>

        <!-- H1 único y optimizado -->
        <h1 class="font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
          Contacto con <span class="text-orange-500">PROMAQ MÁQUINAS</span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
          Escribinos por WhatsApp, llamanos o completá el formulario: cotizamos
          <strong class="font-semibold text-zinc-200">service de autoelevadores, filtros, venta y alquiler de maquinaria</strong>
          para industrias, logística y depósitos.
        </p>

        <!-- CTAs de acción inmediata -->
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a href={urlWhatsapp} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-3 rounded-xl bg-[#25D366] px-8 py-4 text-base font-bold text-slate-900 shadow-xl shadow-black/30 transition hover:-translate-y-0.5 hover:bg-[#1fb855]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Escribir por WhatsApp
          </a>
          <a href="#formulario" class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-600 bg-zinc-800/60 px-8 py-4 text-base font-semibold text-zinc-100 transition hover:-translate-y-0.5 hover:border-yellow-500 hover:text-yellow-400">
            Completar el formulario
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Canales directos ============ -->
  <section id="canales" class="border-b border-zinc-800 bg-slate-950 py-16 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Contacto directo</h2>
      <p class="mt-2 max-w-2xl text-zinc-400">Elegí el canal que te resulte más rápido. Respondemos en horario hábil.</p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

        <!-- WhatsApp -->
        <a href={urlWhatsapp} target="_blank" rel="noopener" class="group rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:-translate-y-1 hover:border-[#25D366]">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-[#25D366]/10 text-[#25D366]">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">WhatsApp</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">{telefonoMostrar}</p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-[#25D366]">Abrir conversación →</p>
        </a>

        <!-- Teléfono -->
        <a href={`tel:${telefonoTel}`} class="group rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:-translate-y-1 hover:border-orange-500">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Teléfono</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">{telefonoMostrar}</p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-orange-400">Llamar ahora →</p>
        </a>

        <!-- Email -->
        <a href={`mailto:${emailMostrar}`} class="group rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:-translate-y-1 hover:border-orange-500">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Email</h3>
          <p class="mt-2 break-all text-sm leading-relaxed text-zinc-400">{emailMostrar}</p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-orange-400">Escribir un mail →</p>
        </a>

        <!-- Horarios -->
        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-yellow-500/10 text-yellow-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Horarios</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Lun a Vie 8:00 a 18:00<br>Sáb 8:00 a 12:00</p>
          <p class="mt-3 text-xs text-zinc-500">Urgencias: consultar por WhatsApp.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Servicios (enlaces rápidos) ============ -->
  <section id="servicios" class="border-b border-zinc-800 bg-slate-900 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">¿Sobre qué querés consultar?</p>
      <p class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        Elegí el servicio y pedí tu presupuesto
      </p>
      <p class="mt-4 max-w-2xl text-zinc-400">
        Cada página tiene su botón de WhatsApp con el motivo ya escrito: solo agregá los datos de tu máquina.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {servicios.map((servicio) => (
          <TarjetaServicio
            href={servicio.href}
            titulo={servicio.titulo}
            descripcion={servicio.descripcion}
            icono={servicio.icono}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Formulario de contacto ============ -->
  <section id="formulario" class="border-b border-zinc-800 bg-slate-950 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-3">

        <!-- Formulario -->
        <div class="lg:col-span-2">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Formulario de consulta</p>
          <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Contanos qué necesitás</h2>
          <p class="mt-4 max-w-2xl text-zinc-400">
            Completá los datos y el motivo de tu consulta. Si preferís una respuesta inmediata, usá el WhatsApp o el
            teléfono.
          </p>

          <form id="formulario-consulta" action={`https://formsubmit.co/${emailMostrar}`} method="post" class="mt-8 rounded-3xl border border-zinc-700 bg-zinc-800/60 p-6 sm:p-8">
            <!-- Backend de envío (FormSubmit): recibe el POST y reenvía la consulta a {emailMostrar} -->
            <input type="hidden" name="_subject" value="Consulta desde la web - PROMAQ MÁQUINAS">
            <input type="hidden" name="_template" value="table">
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_next" value={`${urlPagina}?enviado=1`}>
            <!-- Trampa anti-bots: si la completa un robot, el envío se descarta -->
            <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true">

            <div class="grid gap-6 sm:grid-cols-2">

              <div>
                <label for="nombre" class="mb-2 block text-sm font-semibold text-zinc-200">Nombre y apellido *</label>
                <input type="text" id="nombre" name="nombre" required autocomplete="name" class="w-full rounded-xl border border-zinc-600 bg-slate-900 px-4 py-3 text-zinc-100 placeholder-zinc-500 transition focus:border-orange-500 focus:outline-none" placeholder="Tu nombre">
              </div>

              <div>
                <label for="telefono" class="mb-2 block text-sm font-semibold text-zinc-200">Teléfono / WhatsApp *</label>
                <input type="tel" id="telefono" name="telefono" required autocomplete="tel" class="w-full rounded-xl border border-zinc-600 bg-slate-900 px-4 py-3 text-zinc-100 placeholder-zinc-500 transition focus:border-orange-500 focus:outline-none" placeholder="11 0000-0000">
              </div>

              <div>
                <label for="email" class="mb-2 block text-sm font-semibold text-zinc-200">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" class="w-full rounded-xl border border-zinc-600 bg-slate-900 px-4 py-3 text-zinc-100 placeholder-zinc-500 transition focus:border-orange-500 focus:outline-none" placeholder="tu@empresa.com">
              </div>

              <div>
                <label for="empresa" class="mb-2 block text-sm font-semibold text-zinc-200">Empresa</label>
                <input type="text" id="empresa" name="empresa" autocomplete="organization" class="w-full rounded-xl border border-zinc-600 bg-slate-900 px-4 py-3 text-zinc-100 placeholder-zinc-500 transition focus:border-orange-500 focus:outline-none" placeholder="Nombre de la empresa">
              </div>

              <div class="sm:col-span-2">
                <label for="servicio" class="mb-2 block text-sm font-semibold text-zinc-200">Servicio de interés *</label>
                <select id="servicio" name="servicio" required class="w-full rounded-xl border border-zinc-600 bg-slate-900 px-4 py-3 text-zinc-100 transition focus:border-orange-500 focus:outline-none">
                  {motivosConsulta.map((motivo) => (
                    <option value={motivo}>{motivo}</option>
                  ))}
                </select>
              </div>

              <div class="sm:col-span-2">
                <label for="mensaje" class="mb-2 block text-sm font-semibold text-zinc-200">Mensaje *</label>
                <textarea id="mensaje" name="mensaje" rows="5" required class="w-full rounded-xl border border-zinc-600 bg-slate-900 px-4 py-3 text-zinc-100 placeholder-zinc-500 transition focus:border-orange-500 focus:outline-none" placeholder="Marca y modelo del autoelevador, tipo de filtro, período de alquiler, ubicación de la planta…"></textarea>
              </div>

            </div>

            <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <button type="submit" id="boton-enviar" class="inline-flex items-center justify-center gap-3 rounded-xl bg-orange-500 px-8 py-4 text-base font-bold text-slate-900 shadow-lg shadow-orange-500/25 transition hover:-translate-y-0.5 hover:bg-orange-600 hover:text-white disabled:cursor-not-allowed disabled:opacity-60">
                Enviar consulta
              </button>
              <p class="text-xs leading-relaxed text-zinc-500">
                * Campos obligatorios. La consulta llega a {emailMostrar} y te respondemos a la brevedad.
                Para respuesta inmediata, preferí el WhatsApp.
              </p>
            </div>
            <p id="estado-formulario" role="status" aria-live="polite" class="mt-6 min-h-6 text-sm font-semibold"></p>
          </form>

          <script>
            // Envío sin recargar la página (mejora progresiva). Sin JavaScript,
            // el formulario hace un POST nativo al backend y vuelve con _next.
            const formularioConsulta = document.getElementById('formulario-consulta');
            const botonEnviar = document.getElementById('boton-enviar');
            const estadoFormulario = document.getElementById('estado-formulario');

            if (formularioConsulta && botonEnviar && estadoFormulario) {
              formularioConsulta.addEventListener('submit', async (evento) => {
                evento.preventDefault();
                botonEnviar.disabled = true;
                estadoFormulario.className = 'mt-6 min-h-6 text-sm font-semibold text-zinc-400';
                estadoFormulario.textContent = 'Enviando consulta…';

                try {
                  const datosFormulario = new FormData(formularioConsulta);
                  const emailConsulta = datosFormulario.get('email');
                  if (emailConsulta) datosFormulario.append('_ReplyTo', String(emailConsulta));

                  // Mismo backend, pero en su endpoint JSON para el envío por AJAX
                  const urlBackend = formularioConsulta.action.replace('formsubmit.co/', 'formsubmit.co/ajax/');
                  const respuesta = await fetch(urlBackend, {
                    method: 'POST',
                    body: datosFormulario,
                    headers: { Accept: 'application/json' },
                  });
                  if (!respuesta.ok) throw new Error('Respuesta no válida del backend');

                  formularioConsulta.reset();
                  estadoFormulario.className = 'mt-6 min-h-6 text-sm font-semibold text-green-400';
                  estadoFormulario.textContent = '¡Consulta enviada! Te respondemos a la brevedad por WhatsApp o email.';
                } catch {
                  estadoFormulario.className = 'mt-6 min-h-6 text-sm font-semibold text-red-400';
                  estadoFormulario.textContent = 'No pudimos enviar la consulta. Probá de nuevo o escribinos directo por WhatsApp.';
                } finally {
                  botonEnviar.disabled = false;
                }
              });
            }
          </script>
        </div>

        <!-- Aside: cobertura y datos -->
        <aside>
          <div class="rounded-3xl border border-zinc-700 bg-zinc-800/60 p-7">
            <h2 class="font-display text-xl font-bold text-white">Zona de cobertura</h2>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">
              Service en planta, entregas y visitas técnicas en:
            </p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {zonasVisibles.map((zona) => (
                <li class="rounded-full border border-zinc-700 bg-slate-900/70 px-4 py-1.5 text-sm text-zinc-300">{zona}</li>
              ))}
            </ul>
            <p class="mt-5 text-sm leading-relaxed text-zinc-400">
              Atendemos industrias, logística y depósitos, con foco especial en
              <span class="font-semibold text-yellow-400"> Entre Ríos</span>.
            </p>
          </div>

          <div class="mt-6 rounded-3xl border border-orange-500/30 bg-orange-500/10 p-7">
            <h2 class="font-display text-xl font-bold text-white">¿Máquina detenida?</h2>
            <p class="mt-3 text-sm leading-relaxed text-zinc-300">
              Para urgencias y auxilio mecánico, el canal más rápido es WhatsApp. Priorizamos las máquinas paradas.
            </p>
            <a href={urlWhatsapp} target="_blank" rel="noopener" class="mt-5 inline-flex w-full items-center justify-center gap-3 rounded-xl bg-[#25D366] px-6 py-3.5 text-sm font-bold text-slate-900 transition hover:bg-[#1fb855]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp directo
            </a>
            <a href={`tel:${telefonoTel}`} class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-zinc-600 px-6 py-3.5 text-sm font-semibold text-zinc-100 transition hover:border-yellow-500 hover:text-yellow-400">
              Llamar: {telefonoMostrar}
            </a>
          </div>
        </aside>

      </div>
    </div>
  </section>

</Layout>

---
// ============================================================
// PROMAQ MÁQUINAS - Venta de filtros industriales
// Ruta: /venta-de-filtros/
// Keywords (keywords.md §3): venta de filtros industriales,
// filtros para autoelevadores, filtros nacionales e importados
// para maquinaria, filtros de aire industrial, filtros de aceite
// para autoelevador, filtros hidráulicos para maquinaria pesada,
// filtros de combustible gasoil.
// ============================================================
import Layout from '../layouts/LayoutBase.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import PreguntaFrecuente from '../components/PreguntaFrecuente.astro';

const titulo = 'Venta de Filtros Industriales y para Autoelevadores | PROMAQ';
const descripcion =
  'Venta de filtros industriales nacionales e importados: aire, aceite, combustible gasoil e hidráulicos para autoelevadores y maquinaria. Consultá precios →';
const keywords =
  'venta de filtros industriales, filtros para autoelevadores, filtros nacionales e importados para maquinaria, filtros de aire industrial, filtros de aceite para autoelevador, filtros hidráulicos para maquinaria pesada, filtros de combustible gasoil';

const urlPagina = 'https://www.promaqmaquinas.com.ar/venta-de-filtros/';
const urlWhatsapp =
  'https://wa.me/5491132077351?text=Hola%20Emmanuel%2C%20consulto%20por%20disponibilidad%20y%20precios%20de%20filtros';

// Zonas de cobertura (mismo alcance que el Schema del negocio)
const zonasCobertura = [
  { '@type': 'City', name: 'Ciudad Autónoma de Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Norte del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Oeste del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Sur del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Provincia de Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Entre Ríos' },
  { '@type': 'Country', name: 'Argentina' },
];

// Catálogo de productos (source única: se renderiza en grilla y en el schema)
const tiposDeFiltro = [
  {
    titulo: 'Filtros de aire industrial',
    descripcion:
      'Elementos y cartuchos de aire para motores diésel y entornos con polvo de obra, minería o alimentos. Nacionales e importados, con capacidad de filtración según tu ambiente de trabajo.',
    icono: '<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>',
    esquema: {
      name: 'Filtros de aire industrial para autoelevadores y maquinaria',
      description:
        'Venta de filtros de aire industrial y cartuchos de filtración para motores diésel, autoelevadores y maquinaria pesada, en versiones nacionales e importadas.',
    },
  },
  {
    titulo: 'Filtros de aceite para autoelevador',
    descripcion:
      'Filtros de aceite para motores diésel, nafta y GLP. Cambio periódico recomendado junto con el service preventivo para proteger el motor.',
    icono: '<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>',
    esquema: {
      name: 'Filtros de aceite para autoelevadores',
      description:
        'Venta de filtros de aceite para autoelevadores y motores industriales diésel, nafta y GLP, nacionales e importados.',
    },
  },
  {
    titulo: 'Filtros de combustible gasoil',
    descripcion:
      'Filtros de combustible gasoil (sedimentador y prefiltro) para proteger la bomba y la inyección. Stock para los modelos más usados en logística e industria.',
    icono:
      '<path d="M3 22h12V4a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><line x1="3" y1="10" x2="15" y2="10"/><path d="M15 8l3 3v7a2 2 0 0 1-4 0"/>',
    esquema: {
      name: 'Filtros de combustible gasoil para maquinaria pesada',
      description:
        'Venta de filtros de combustible gasoil, sedimentadores y prefiltrado para autoelevadores y maquinaria pesada.',
    },
  },
  {
    titulo: 'Filtros hidráulicos para maquinaria pesada',
    descripcion:
      'Filtros hidráulicos para maquinaria pesada y circuitos de presión: recambio, pulido y retorno. Clave en el service hidráulico de autoelevadores.',
    icono:
      '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
    esquema: {
      name: 'Filtros hidráulicos para maquinaria pesada',
      description:
        'Venta de filtros hidráulicos para maquinaria pesada, autoelevadores y circuitos de recambio, pulido y retorno.',
    },
  },
];

// Schema adicional: Service + ItemList de Product + BreadcrumbList
const schemaAdicional = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${urlPagina}#servicio`,
      name: 'Venta de filtros industriales nacionales e importados',
      serviceType: 'Venta de filtros de aire, aceite, combustible e hidráulicos para autoelevadores y maquinaria',
      description:
        'Venta de filtros industriales nacionales e importados para autoelevadores y maquinaria pesada: filtros de aire, aceite, combustible gasoil e hidráulicos, con asesoramiento técnico y equivalencias según marca y modelo.',
      url: urlPagina,
      provider: { '@id': 'https://www.promaqmaquinas.com.ar/#negocio' },
      areaServed: zonasCobertura,
    },
    {
      '@type': 'ItemList',
      name: 'Tipos de filtros industriales disponibles',
      numberOfItems: tiposDeFiltro.length,
      itemListElement: tiposDeFiltro.map((filtro, indice) => ({
        '@type': 'ListItem',
        position: indice + 1,
        item: {
          '@type': 'Product',
          name: filtro.esquema.name,
          description: filtro.esquema.description,
          category: 'Filtros industriales',
          url: urlPagina,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.promaqmaquinas.com.ar/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Venta de filtros industriales',
          item: urlPagina,
        },
      ],
    },
  ],
};

// Pasos de compra / asesoramiento (H2 de sección → H3 por paso)
const pasosCompra = [
  {
    titulo: 'Pedinos el filtro',
    descripcion:
      'Pasanos la marca y modelo del autoelevador, el número de parte del filtro o una foto del elemento actual. Si no sabés qué es, te orientamos.',
  },
  {
    titulo: 'Verificamos la equivalencia',
    descripcion:
      'Buscamos el repuesto original o su equivalente nacional o importado, y te informamos disponibilidad y precios. Si el filtro no existe, lo fabricamos a medida.',
  },
  {
    titulo: 'Coordinamos la entrega',
    descripcion:
      'Definimos entrega en planta o retiro dentro de nuestra zona de cobertura (CABA, GBA y Entre Ríos) con la fecha que necesite tu operación.',
  },
  {
    titulo: 'Acompañamos el reemplazo',
    descripcion:
      'Te indicamos intervalos de cambio y, si hacés el service con nosotros, registramos los filtros instalados para el próximo mantenimiento.',
  },
];

// Marcas compatibles (chips visibles)
const marcasFiltros = ['Donaldson', 'Fleetguard', 'Baldwin', 'Sakura', 'Hifi Filter', 'Mann+Hummel', 'Wix Filters', 'Equivalentes nacionales'];
const marcasMaquinarias = ['Toyota', 'Nissan', 'Chevrolet', 'Clark', 'Hangcha', 'Baoli', 'JCB', 'Caterpillar', 'Komatsu', 'Otras marcas'];

// FAQ: misma fuente para el acordeón visible y el schema FAQPage
const preguntasFrecuentes = [
  {
    pregunta: '¿Venden filtros nacionales e importados para maquinaria?',
    respuesta:
      'Sí. Trabajamos con filtros nacionales e importados para maquinaria y autoelevadores: originales o equivalentes de primera calidad, siempre indicando el origen de cada repuesto.',
  },
  {
    pregunta: '¿Qué tipos de filtros tienen disponibles?',
    respuesta:
      'Filtros de aire industrial, filtros de aceite para autoelevador, filtros de combustible gasoil y filtros hidráulicos para maquinaria pesada (recambio, pulido y retorno).',
  },
  {
    pregunta: '¿Cómo elijo el filtro correcto de mi autoelevador?',
    respuesta:
      'Enviá la marca y modelo del autoelevador, el número de parte del filtro o una foto del elemento actual. Cruzamos los datos con la ficha técnica y te confirmamos la equivalencia exacta.',
  },
  {
    pregunta: '¿Tienen filtros para todas las marcas de autoelevadores?',
    respuesta:
      'Cubrimos las marcas más usadas en logística e industria (Toyota, Nissan, Chevrolet, Clark, Hangcha y otras). Si el filtro de tu máquina no está en el mercado, lo fabricamos a medida en nuestro servicio de filtros especiales.',
  },
  {
    pregunta: '¿Hacen precios por volumen para industrias y depósitos?',
    respuesta:
      'Sí. Cotizamos por volumen para industrias, logística y depósitos, y podemos armar pedidos periódicos según la frecuencia de tus services.',
  },
  {
    pregunta: '¿Cómo se entregan los filtros comprados?',
    respuesta:
      'Coordinamos entrega en planta o retiro dentro de nuestra zona de cobertura: Ciudad Autónoma de Buenos Aires, Zona Norte, Zona Oeste y Zona Sur del GBA, provincia de Buenos Aires y Entre Ríos. Escribinos con tu ubicación para confirmar la modalidad.',
  },
];

// Schema FAQPage generado desde la misma fuente (garantiza el espejo 1:1)
const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntasFrecuentes.map((item) => ({
    '@type': 'Question',
    name: item.pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.respuesta,
    },
  })),
};

// Otros servicios (misma data que la home)
const otrosServicios = [
  {
    href: '/reparacion-autoelevadores/',
    titulo: 'Service y reparación de autoelevadores',
    descripcion:
      'Mantenimiento preventivo y correctivo en planta o taller: frenos, transmisión, hidráulica y mástiles.',
    icono:
      '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    href: '/fabricacion-filtros-especiales/',
    titulo: 'Fabricación de filtros especiales',
    descripcion:
      'Filtros a medida sobre muestra, plano o medidas específicas para maquinaria fuera de estándar.',
    icono:
      '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
  },
  {
    href: '/venta-de-autoelevadores/',
    titulo: 'Venta de autoelevadores',
    descripcion:
      'Autoelevadores nuevos y usados seleccionados, reacondicionados con garantía. Diésel, nafta, GLP y eléctricos.',
    icono:
      '<rect x="3" y="6" width="7" height="10" rx="1"/><line x1="13" y1="3" x2="13" y2="16"/><line x1="13" y1="16" x2="19" y2="16"/><circle cx="6" cy="18.5" r="2"/><circle cx="16" cy="18.5" r="2"/>',
  },
  {
    href: '/alquiler-de-maquinaria/',
    titulo: 'Alquiler de maquinaria y autoelevadores',
    descripcion:
      'Renta por día, mes o largo plazo con mantenimiento incluido. Ideal para depósitos logísticos, obras y descarga de camiones.',
    icono:
      '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  },
];
---

<Layout title={titulo} description={descripcion} keywords={keywords} schemaFaq={schemaFaq} schemaAdicional={schemaAdicional}>

  <!-- ============ Hero Section ============ -->
  <section id="inicio" class="relative overflow-hidden border-b border-zinc-800 bg-slate-900 scroll-mt-24">
    <!-- Fondo: rejilla industrial + resplandor naranja -->
    <div class="fondo-rejilla degradado-hero absolute inset-0 opacity-40" aria-hidden="true"></div>
    <div class="absolute -top-32 right-0 h-96 w-96 rounded-full bg-orange-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-yellow-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
      <div class="max-w-4xl">

        <!-- Miga de pan visible (espejo del BreadcrumbList del schema) -->
        <nav aria-label="Miga de pan" class="mb-6 text-sm">
          <ol class="flex flex-wrap items-center gap-2 text-zinc-500">
            <li><a href="/" class="transition hover:text-orange-400">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-zinc-300" aria-current="page">Venta de filtros industriales</li>
          </ol>
        </nav>

        <!-- Badge -->
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-yellow-500/30 bg-yellow-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-yellow-400">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-yellow-400"></span>
          </span>
          Filtros nacionales e importados · Asesoramiento técnico
        </p>

        <!-- H1 único y optimizado (keyword primaria de keywords.md §3) -->
        <h1 class="font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
          Venta de <span class="text-orange-500">filtros industriales</span> para autoelevadores y maquinaria
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
          Filtros nacionales e importados para maquinaria pesada y autoelevadores:
          <strong class="font-semibold text-zinc-200">aire, aceite, combustible gasoil e hidráulicos</strong>,
          con verificación de equivalencias según marca y modelo. Consultá disponibilidad y precios por WhatsApp.
        </p>

        <!-- CTAs de acción inmediata -->
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a href={urlWhatsapp} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-3 rounded-xl bg-orange-500 px-8 py-4 text-base font-bold text-slate-900 shadow-xl shadow-orange-500/25 transition hover:-translate-y-0.5 hover:bg-orange-600 hover:text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Consultar filtros por WhatsApp
          </a>
          <a href="#catalogo" class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-600 bg-zinc-800/60 px-8 py-4 text-base font-semibold text-zinc-100 transition hover:-translate-y-0.5 hover:border-yellow-500 hover:text-yellow-400">
            Ver tipos de filtros
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Bloque de confianza ============ -->
  <section id="ventajas" class="border-b border-zinc-800 bg-slate-950 py-16 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">¿Por qué comprar filtros en PROMAQ MÁQUINAS?</h2>
      <p class="mt-2 max-w-2xl text-zinc-400">El repuesto correcto, con la información técnica para cambiarlo a tiempo.</p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Las cuatro familias, un solo proveedor</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Filtros de aire, aceite, combustible gasoil e hidráulicos, con reposición periódica según la frecuencia de tus services.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Nacionales e importados</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Originales o equivalentes, siempre indicando el origen y la marca del filtro.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Asesoramiento técnico</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Verificamos equivalencias con marca, modelo o número de parte: sin compras a ciegas.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Precios por volumen</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Cotizaciones para industrias, logística y depósitos, con pedidos periódicos según tu frecuencia de service.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Catálogo de filtros ============ -->
  <section id="catalogo" class="border-b border-zinc-800 bg-slate-900 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Catálogo de filtros</p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        Cuatro familias de filtros para mantener tu maquinaria
      </h2>
      <p class="mt-4 max-w-2xl text-zinc-400">
        Filtros de aire industrial, aceite, combustible gasoil e hidráulicos para autoelevadores, maquinaria pesada e
        industria. Si el repuesto no existe, lo fabricamos a medida.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {tiposDeFiltro.map((filtro) => (
          <article class="group flex flex-col rounded-2xl border border-zinc-700 bg-zinc-800/70 p-7 transition hover:-translate-y-1 hover:border-orange-500">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500/10 text-orange-400 transition group-hover:bg-orange-500 group-hover:text-slate-900">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={filtro.icono}></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white">{filtro.titulo}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-zinc-400">{filtro.descripcion}</p>
            <a href={urlWhatsapp} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 font-semibold text-orange-400 transition hover:text-yellow-400">
              Consultar disponibilidad y precios
              <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Marcas compatibles y asesoramiento ============ -->
  <section id="marcas" class="border-b border-zinc-800 bg-slate-950 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Marcas y asesoramiento</p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        Marcas compatibles y verificación de equivalencias
      </h2>
      <p class="mt-4 max-w-2xl text-zinc-400">
        Trabajamos con filtros de las marcas más usadas del mercado y con equivalentes nacionales de primera calidad.
        Antes de vender, verificamos la equivalencia contra la ficha de tu máquina.
      </p>

      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <div class="rounded-3xl border border-zinc-700 bg-zinc-800/60 p-8">
          <h3 class="font-display text-xl font-bold text-white">Marcas de filtros</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {marcasFiltros.map((marca) => (
              <li class="rounded-full border border-zinc-700 bg-slate-900/70 px-4 py-1.5 text-sm text-zinc-300">{marca}</li>
            ))}
          </ul>
          <p class="mt-5 text-sm leading-relaxed text-zinc-400">
            Si buscás una marca puntual, consultanos: la conseguimos o te proponemos el equivalente técnico más cercano.
          </p>
        </div>

        <div class="rounded-3xl border border-zinc-700 bg-zinc-800/60 p-8">
          <h3 class="font-display text-xl font-bold text-white">Autoelevadores y maquinaria compatibles</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {marcasMaquinarias.map((marca) => (
              <li class="rounded-full border border-zinc-700 bg-slate-900/70 px-4 py-1.5 text-sm text-zinc-300">{marca}</li>
            ))}
          </ul>
          <p class="mt-5 text-sm leading-relaxed text-zinc-400">
            Para identificar tu filtro, alcanza con la marca y modelo de la máquina, el número de parte o una foto del
            elemento actual.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Proceso de compra ============ -->
  <section id="proceso" class="border-b border-zinc-800 bg-slate-900 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Cómo comprar</p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        De la consulta a la entrega, en cuatro pasos
      </h2>

      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pasosCompra.map((paso, indice) => (
          <li class="relative rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
            <span class="font-display text-4xl font-extrabold text-orange-500/30" aria-hidden="true">{String(indice + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-lg font-bold text-white">{paso.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{paso.descripcion}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ Otros servicios relacionados ============ -->
  <section id="otros-servicios" class="border-b border-zinc-800 bg-slate-950 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Otros servicios</p>
      <p class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        Filtros especiales, service, venta y alquiler
      </p>
      <p class="mt-4 max-w-2xl text-zinc-400">
        Todo lo que necesita tu operación logística, con el mismo equipo técnico detrás.
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {otrosServicios.map((servicio) => (
          <TarjetaServicio
            href={servicio.href}
            titulo={servicio.titulo}
            descripcion={servicio.descripcion}
            icono={servicio.icono}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Banner de CTA ============ -->
  <section id="consulta-filtros" class="border-b border-zinc-800 bg-slate-900 py-16 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border-l-4 border-orange-500 bg-zinc-800/80 p-8 shadow-2xl shadow-black/40 sm:p-12">
        <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-yellow-500/10 blur-3xl" aria-hidden="true"></div>

        <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-orange-500/40 bg-orange-500/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-orange-400">
              Stock y equivalencias
            </p>
            <h2 class="font-display text-2xl font-extrabold leading-snug text-white sm:text-3xl">
              ¿Necesitás un filtro? Pasanos el número de parte o una foto
            </h2>
            <p class="mt-4 leading-relaxed text-zinc-400">
              Respondemos con disponibilidad y precio. Si el filtro de tu máquina no está en el mercado, lo fabricamos a
              medida en nuestro servicio de filtros especiales.
            </p>
          </div>

          <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col">
            <a href={urlWhatsapp} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-3 rounded-xl bg-orange-500 px-7 py-4 text-base font-bold text-slate-900 shadow-lg shadow-orange-500/25 transition hover:bg-orange-600 hover:text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Consultar por WhatsApp
            </a>
            <a href="tel:+5491132077351" class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-600 px-7 py-4 text-base font-semibold text-zinc-100 transition hover:border-yellow-500 hover:text-yellow-400">
              Llamar: 11 3207-7351
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Preguntas Frecuentes (FAQ / AEO) ============ -->
  <section id="preguntas-frecuentes" class="border-b border-zinc-800 bg-slate-950 py-20 scroll-mt-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Preguntas frecuentes</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Respuestas directas antes de comprar filtros</h2>
      <p class="mt-4 text-zinc-400">Las dudas más habituales de industrias, logística y depósitos que compran filtros con PROMAQ MÁQUINAS.</p>

      <!-- Acordeón con <details>/<summary> nativos: accesible y sin JavaScript -->
      <div class="mt-10 space-y-4">
        {preguntasFrecuentes.map((item) => (
          <PreguntaFrecuente pregunta={item.pregunta} respuesta={item.respuesta} />
        ))}
      </div>

      <div class="mt-10 rounded-2xl border border-orange-500/30 bg-orange-500/10 p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
        <p class="font-semibold text-zinc-100">¿No encontraste tu consulta? Escribinos y te respondemos con la equivalencia.</p>
        <a href="/contacto/" class="mt-4 inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-orange-500 px-6 py-3 text-sm font-bold text-slate-900 transition hover:bg-orange-600 hover:text-white sm:mt-0">
          Ir al formulario de contacto
        </a>
      </div>
    </div>
  </section>

</Layout>

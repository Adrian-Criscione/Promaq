---
// ============================================================
// PROMAQ MÁQUINAS - Venta de autoelevadores
// Ruta: /venta-de-autoelevadores/
// Keywords (keywords.md §5): venta de autoelevadores usados
// seleccionados, comprar autoelevador reacondicionado, venta de
// autoelevadores nuevos buenos aires, autoelevadores con garantia,
// autoelevadores diesel nafta glp electricos, cotizacion de
// autoelevador para empresas.
// ============================================================
import Layout from '../layouts/LayoutBase.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import PreguntaFrecuente from '../components/PreguntaFrecuente.astro';

const titulo = 'Venta de Autoelevadores en Buenos Aires | PROMAQ';
const descripcion =
  'Venta de autoelevadores diésel, nafta, GLP y eléctricos: usados seleccionados y reacondicionados con garantía. Cotización para empresas →';
const keywords =
  'venta de autoelevadores usados seleccionados, comprar autoelevador reacondicionado, venta de autoelevadores nuevos buenos aires, autoelevadores con garantia, autoelevadores diesel nafta glp electricos, cotizacion de autoelevador para empresas';

const urlPagina = 'https://www.promaqmaquinas.com.ar/venta-de-autoelevadores/';
const urlWhatsapp =
  'https://wa.me/5491132077351?text=Hola%20Emmanuel%2C%20consulto%20por%20autoelevadores%20disponibles%20para%20la%20venta';

// Zonas de cobertura (mismo alcance que el Schema del negocio)
const zonasCobertura = [
  { '@type': 'City', name: 'Ciudad Autónoma de Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Norte del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Oeste del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Sur del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Provincia de Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Entre Ríos' },
  { '@type': 'Country', name: 'Argentina' },
];

// Tipos de unidades (fuente única: grilla visible + schema ItemList de Product)
const tiposDeUnidad = [
  {
    titulo: 'Autoelevadores diésel',
    descripcion:
      'La opción más habitual para depósitos y exteriores: potencia, autonomía y bajo costo operativo. Unidades nuevas y usadas seleccionadas, reacondicionadas con garantía.',
    icono:
      '<rect x="3" y="6" width="7" height="10" rx="1"/><line x1="13" y1="3" x2="13" y2="16"/><line x1="13" y1="16" x2="19" y2="16"/><circle cx="6" cy="18.5" r="2"/><circle cx="16" cy="18.5" r="2"/>',
    esquema: {
      name: 'Autoelevadores diésel nuevos y reacondicionados',
      description:
        'Venta de autoelevadores diésel para depósitos e industria, en versión nueva o usada seleccionada y reacondicionada con garantía.',
    },
  },
  {
    titulo: 'Autoelevadores nafta y GLP',
    descripcion:
      'Ideales para interiores y grandes recintos ventilados, con arranque rápido y versatilidad de combustible. Disponibles en versiones nuevas y reacondicionadas.',
    icono:
      '<path d="M3 22h12V4a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><line x1="3" y1="10" x2="15" y2="10"/><path d="M15 8l3 3v7a2 2 0 0 1-4 0"/>',
    esquema: {
      name: 'Autoelevadores nafta y GLP',
      description:
        'Venta de autoelevadores a gas nafta y GLP, nuevos y reacondicionados con garantía, para uso en interiores con buena ventilación.',
    },
  },
  {
    titulo: 'Autoelevadores eléctricos',
    descripcion:
      'Silenciosos y sin emisiones: la mejor opción para alimentos, farmacéutica y espacios cerrados. Baterías revisadas y sistema de control verificado en cada unidad.',
    icono: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
    esquema: {
      name: 'Autoelevadores eléctricos nuevos y reacondicionados',
      description:
        'Venta de autoelevadores eléctricos para uso en interiores, con baterías y sistemas revisados, en versiones nuevas y reacondicionadas con garantía.',
    },
  },
];

// Schema adicional: Service + ItemList de Product + BreadcrumbList
const schemaAdicional = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${urlPagina}#servicio`,
      name: 'Venta de autoelevadores nuevos y reacondicionados con garantía',
      serviceType: 'Venta de autoelevadores diésel, nafta, GLP y eléctricos, nuevos y usados seleccionados',
      description:
        'Venta de autoelevadores en Buenos Aires: unidades diésel, nafta, GLP y eléctricas, usados seleccionados y reacondicionados con garantía, con cotización para empresas y service post venta.',
      url: urlPagina,
      provider: { '@id': 'https://www.promaqmaquinas.com.ar/#negocio' },
      areaServed: zonasCobertura,
    },
    {
      '@type': 'ItemList',
      name: 'Tipos de autoelevadores disponibles',
      numberOfItems: tiposDeUnidad.length,
      itemListElement: tiposDeUnidad.map((unidad, indice) => ({
        '@type': 'ListItem',
        position: indice + 1,
        item: {
          '@type': 'Product',
          name: unidad.esquema.name,
          description: unidad.esquema.description,
          category: 'Autoelevadores',
          url: urlPagina,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.promaqmaquinas.com.ar/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Venta de autoelevadores',
          item: urlPagina,
        },
      ],
    },
  ],
};

// Proceso de selección y reacondición (H2 → H3)
const procesoSeleccion = [
  {
    titulo: 'Selección de la unidad',
    descripcion:
      'Elegimos autoelevadores usados por estado, horas de uso y mantenimiento registrado. Las unidades fuera de estándar no ingresan al stock.',
  },
  {
    titulo: 'Diagnóstico integral',
    descripcion:
      'Revisamos motor o batería, hidráulica, transmisión, frenos, mástil e izaje, y componentes eléctricos. Se documenta el detalle de cada punto revisado.',
  },
  {
    titulo: 'Reacondicionamiento y garantía',
    descripcion:
      'Reemplazamos desgastados, ajustamos y probamos la máquina. Cada autoelevador reacondicionado sale con garantía sobre el trabajo realizado.',
  },
  {
    titulo: 'Entrega y service posterior',
    descripcion:
      'Entregamos la unidad con su ficha de trabajos y seguimos siendo tu taller: service preventivo, repuestos y filtros para seguir operando.',
  },
];

// FAQ: misma fuente para el acordeón visible y el schema FAQPage
const preguntasFrecuentes = [
  {
    pregunta: '¿Qué formas de pago aceptan?',
    respuesta:
      'Efectivo y transferencia bancaria. Escribinos para coordinar la operación y las opciones de pago disponibles para tu empresa.',
  },
  {
    pregunta: '¿Qué tipos de autoelevadores tienen disponibles?',
    respuesta:
      'Autoelevadores diésel, nafta, GLP y eléctricos, en distintas capacidades de carga y alturas de mástil. La disponibilidad cambia según el stock: consultanos por las unidades vigentes.',
  },
  {
    pregunta: '¿Hacen cotización de autoelevador para empresas?',
    respuesta:
      'Sí. Cotizamos para empresas e industrias, con opciones de compra, alquiler o flota mixta, y coordinamos la entrega en CABA, GBA, provincia de Buenos Aires y Entre Ríos.',
  },
  {
    pregunta: '¿Cómo seleccionan y reacondicionan las unidades?',
    respuesta:
      'Cada unidad usada pasa por un diagnóstico de motor o batería, hidráulica, transmisión, frenos e izaje; se reemplazan los componentes desgastados y se prueba antes de salir a la venta.',
  },
  {
    pregunta: '¿Puedo revisar la máquina antes de comprarla?',
    respuesta:
      'Sí. Coordinamos la revisión de la unidad antes de la venta y te compartimos el detalle de los trabajos realizados y el estado de cada sistema.',
  },
  {
    pregunta: '¿Quién da el service después de la compra?',
    respuesta:
      'Nosotros: PROMAQ MÁQUINAS es service integral de autoelevadores, así que podés hacer el mantenimiento preventivo, los filtros y las reparaciones con el mismo equipo técnico que te vendió la máquina.',
  },
];

// Schema FAQPage generado desde la misma fuente (garantiza el espejo 1:1)
const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntasFrecuentes.map((item) => ({
    '@type': 'Question',
    name: item.pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.respuesta,
    },
  })),
};

// Otros servicios (misma data que la home)
const otrosServicios = [
  {
    href: '/reparacion-autoelevadores/',
    titulo: 'Service y reparación de autoelevadores',
    descripcion:
      'Mantenimiento preventivo y correctivo en planta o taller: frenos, transmisión, hidráulica y mástiles.',
    icono:
      '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    href: '/venta-de-filtros/',
    titulo: 'Venta de filtros industriales',
    descripcion:
      'Filtros de aire, aceite, combustible e hidráulicos, nacionales e importados, para autoelevadores y maquinaria.',
    icono: '<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>',
  },
  {
    href: '/fabricacion-filtros-especiales/',
    titulo: 'Fabricación de filtros especiales',
    descripcion:
      'Filtros a medida sobre muestra, plano o medidas específicas para maquinaria fuera de estándar.',
    icono:
      '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
  },
  {
    href: '/alquiler-de-maquinaria/',
    titulo: 'Alquiler de maquinaria y autoelevadores',
    descripcion:
      'Renta por día, mes o largo plazo con mantenimiento incluido. Ideal para depósitos logísticos, obras y descarga de camiones.',
    icono:
      '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  },
];
---

<Layout title={titulo} description={descripcion} keywords={keywords} schemaFaq={schemaFaq} schemaAdicional={schemaAdicional}>

  <!-- ============ Hero Section ============ -->
  <section id="inicio" class="relative overflow-hidden border-b border-zinc-800 bg-slate-900 scroll-mt-24">
    <!-- Fondo: rejilla industrial + resplandor naranja -->
    <div class="fondo-rejilla degradado-hero absolute inset-0 opacity-40" aria-hidden="true"></div>
    <div class="absolute -top-32 right-0 h-96 w-96 rounded-full bg-orange-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-yellow-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
      <div class="max-w-4xl">

        <!-- Miga de pan visible (espejo del BreadcrumbList del schema) -->
        <nav aria-label="Miga de pan" class="mb-6 text-sm">
          <ol class="flex flex-wrap items-center gap-2 text-zinc-500">
            <li><a href="/" class="transition hover:text-orange-400">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-zinc-300" aria-current="page">Venta de autoelevadores</li>
          </ol>
        </nav>

        <!-- Badge -->
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-yellow-500/30 bg-yellow-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-yellow-400">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-yellow-400"></span>
          </span>
          Unidades seleccionadas · Reacondicionadas con garantía
        </p>

        <!-- H1 único y optimizado (keywords.md §5) -->
        <h1 class="font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
          Venta de <span class="text-orange-500">autoelevadores</span> en Buenos Aires
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
          Autoelevadores diésel, nafta, GLP y eléctricos: unidades nuevas y
          <strong class="font-semibold text-zinc-200">usados seleccionados, reacondicionados con garantía</strong>.
          Cotización para empresas y entrega en CABA, GBA y Entre Ríos.
        </p>

        <!-- CTAs de acción inmediata -->
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a href={urlWhatsapp} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-3 rounded-xl bg-orange-500 px-8 py-4 text-base font-bold text-slate-900 shadow-xl shadow-orange-500/25 transition hover:-translate-y-0.5 hover:bg-orange-600 hover:text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Consultar unidades disponibles
          </a>
          <a href="#unidades" class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-600 bg-zinc-800/60 px-8 py-4 text-base font-semibold text-zinc-100 transition hover:-translate-y-0.5 hover:border-yellow-500 hover:text-yellow-400">
            Ver tipos de autoelevadores
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Bloque de confianza ============ -->
  <section id="ventajas" class="border-b border-zinc-800 bg-slate-950 py-16 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">¿Por qué comprar tu autoelevador en PROMAQ MÁQUINAS?</h2>
      <p class="mt-2 max-w-2xl text-zinc-400">Vendemos lo que nosotros mismos mantendríamos.</p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Selección y garantía</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Usados seleccionados y reacondicionados con garantía sobre el trabajo realizado.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Diésel, nafta, GLP y eléctricos</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">La tecnología de tracción que tu operación necesita, para interiores o exteriores.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Cotización para empresas</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Propuestas para industrias, logística y depósitos, con opciones de flota.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Service post venta</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Mantenimiento, filtros y reparaciones con el mismo equipo técnico, en planta o taller.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Tipos de unidades ============ -->
  <section id="unidades" class="border-b border-zinc-800 bg-slate-900 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Unidades disponibles</p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        Autoelevadores diésel, nafta, GLP y eléctricos
      </h2>
      <p class="mt-4 max-w-2xl text-zinc-400">
        Stock rotativo de unidades nuevas y usadas seleccionadas. Escribinos para conocer las
        <strong class="font-semibold text-zinc-200">unidades disponibles hoy</strong> con fotos, ficha y precio.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {tiposDeUnidad.map((unidad) => (
          <article class="group flex flex-col rounded-2xl border border-zinc-700 bg-zinc-800/70 p-7 transition hover:-translate-y-1 hover:border-orange-500">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500/10 text-orange-400 transition group-hover:bg-orange-500 group-hover:text-slate-900">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={unidad.icono}></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white">{unidad.titulo}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-zinc-400">{unidad.descripcion}</p>
            <a href={urlWhatsapp} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 font-semibold text-orange-400 transition hover:text-yellow-400">
              Consultar disponibilidad
              <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Proceso de selección y reacondición ============ -->
  <section id="proceso" class="border-b border-zinc-800 bg-slate-950 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Cómo preparamos cada unidad</p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        De la selección a la entrega, con garantía
      </h2>

      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {procesoSeleccion.map((paso, indice) => (
          <li class="relative rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
            <span class="font-display text-4xl font-extrabold text-orange-500/30" aria-hidden="true">{String(indice + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-lg font-bold text-white">{paso.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{paso.descripcion}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ Otros servicios relacionados ============ -->
  <section id="otros-servicios" class="border-b border-zinc-800 bg-slate-900 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Otros servicios</p>
      <p class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        Service, filtros, fabricación y alquiler
      </p>
      <p class="mt-4 max-w-2xl text-zinc-400">
        Todo lo que necesita tu operación logística, con el mismo equipo técnico detrás.
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {otrosServicios.map((servicio) => (
          <TarjetaServicio
            href={servicio.href}
            titulo={servicio.titulo}
            descripcion={servicio.descripcion}
            icono={servicio.icono}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Banner de CTA ============ -->
  <section id="cotizacion" class="border-b border-zinc-800 bg-slate-950 py-16 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border-l-4 border-orange-500 bg-zinc-800/80 p-8 shadow-2xl shadow-black/40 sm:p-12">
        <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-yellow-500/10 blur-3xl" aria-hidden="true"></div>

        <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-orange-500/40 bg-orange-500/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-orange-400">
              Cotización para empresas
            </p>
            <h2 class="font-display text-2xl font-extrabold leading-snug text-white sm:text-3xl">
              ¿Comprás un autoelevador? Pedí la cotización
            </h2>
            <p class="mt-4 leading-relaxed text-zinc-400">
              Contanos qué tarea realiza, la capacidad de carga, la altura de izaje y el espacio de trabajo: te
              recomendamos la unidad correcta o la alternativa de alquiler si conviene.
            </p>
          </div>

          <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col">
            <a href={urlWhatsapp} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-3 rounded-xl bg-orange-500 px-7 py-4 text-base font-bold text-slate-900 shadow-lg shadow-orange-500/25 transition hover:bg-orange-600 hover:text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Pedir cotización
            </a>
            <a href="tel:+5491132077351" class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-600 px-7 py-4 text-base font-semibold text-zinc-100 transition hover:border-yellow-500 hover:text-yellow-400">
              Llamar: 11 3207-7351
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Preguntas Frecuentes (FAQ / AEO) ============ -->
  <section id="preguntas-frecuentes" class="border-b border-zinc-800 bg-slate-900 py-20 scroll-mt-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Preguntas frecuentes</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Respuestas directas antes de comprar un autoelevador</h2>
      <p class="mt-4 text-zinc-400">Las dudas más habituales de industrias, logística y depósitos que compran con PROMAQ MÁQUINAS.</p>

      <!-- Acordeón con <details>/<summary> nativos: accesible y sin JavaScript -->
      <div class="mt-10 space-y-4">
        {preguntasFrecuentes.map((item) => (
          <PreguntaFrecuente pregunta={item.pregunta} respuesta={item.respuesta} />
        ))}
      </div>

      <div class="mt-10 rounded-2xl border border-orange-500/30 bg-orange-500/10 p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
        <p class="font-semibold text-zinc-100">¿No encontraste tu consulta? Escribinos y te respondemos con las unidades vigentes.</p>
        <a href="/contacto/" class="mt-4 inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-orange-500 px-6 py-3 text-sm font-bold text-slate-900 transition hover:bg-orange-600 hover:text-white sm:mt-0">
          Ir al formulario de contacto
        </a>
      </div>
    </div>
  </section>

</Layout>

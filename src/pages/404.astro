---
// ============================================================
// PROMAQ MÁQUINAS - Página 404
// Genera dist/404.html (Vercel la sirve con status 404).
// noindex: no debe indexarse (prop de LayoutBase).
// ============================================================
import Layout from '../layouts/LayoutBase.astro';

const titulo = 'Página no encontrada (404) | PROMAQ MÁQUINAS';
const descripcion =
  'La página que buscás no existe. Volvé al inicio o elegí el servicio que necesitás: reparación de autoelevadores, filtros, venta y alquiler de maquinaria. PROMAQ MÁQUINAS, Buenos Aires.';

const urlWhatsapp =
  'https://wa.me/5491132077351?text=Hola%20Emmanuel%2C%20me%20comunico%20desde%20la%20web%20para%20consultar%20sobre%20un%20servicio.';

// Salidas rápidas hacia las páginas del sitio
const servicios = [
  { href: '/reparacion-autoelevadores/', texto: 'Reparación de autoelevadores' },
  { href: '/venta-de-filtros/', texto: 'Venta de filtros industriales' },
  { href: '/fabricacion-filtros-especiales/', texto: 'Fabricación de filtros especiales' },
  { href: '/venta-de-autoelevadores/', texto: 'Venta de autoelevadores' },
  { href: '/alquiler-de-maquinaria/', texto: 'Alquiler de maquinaria' },
  { href: '/contacto/', texto: 'Contacto' },
];
---

<Layout title={titulo} description={descripcion} noindex>
  <section class="bg-slate-950 py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-display text-7xl font-extrabold text-orange-500 sm:text-8xl">404</p>

      <h1 class="mt-6 font-display text-3xl font-bold text-white sm:text-4xl">Página no encontrada</h1>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-zinc-400">
        El enlace que seguiste no existe o fue movido. Volvé al inicio, elegí abajo el servicio que necesitás
        o consultanos directo por WhatsApp.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-500 px-8 py-4 text-base font-bold text-slate-900 shadow-lg shadow-orange-500/25 transition hover:-translate-y-0.5 hover:bg-orange-600 hover:text-white">
          Volver al inicio
        </a>
        <a href={urlWhatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-600 bg-zinc-800/60 px-8 py-4 text-base font-semibold text-zinc-100 transition hover:-translate-y-0.5 hover:border-yellow-500 hover:text-yellow-400">
          Escribir por WhatsApp
        </a>
      </div>

      <ul class="mt-12 grid gap-4 text-left sm:grid-cols-2 lg:grid-cols-3">
        {servicios.map((servicio) => (
          <li>
            <a href={servicio.href} class="block rounded-2xl border border-zinc-700 bg-zinc-800/60 p-5 text-sm font-semibold text-zinc-200 transition hover:border-orange-500/60 hover:text-orange-400">
              {servicio.texto}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

---
// ============================================================
// PROMAQ MÁQUINAS - Reparación y servicio técnico de autoelevadores
// Ruta: /reparacion-autoelevadores/
// Keywords (keywords.md §2): reparacion de autoelevadores,
// service de autoelevadores en planta, mantenimiento preventivo
// de autoelevadores, arreglo de frenos y transmision autoelevador,
// service hidráulico para autoelevadores, reparación de
// autoelevadores combustión y eléctricos, auxilio mecánico
// autoelevadores.
// ============================================================
import Layout from '../layouts/LayoutBase.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import PreguntaFrecuente from '../components/PreguntaFrecuente.astro';

const titulo = 'Reparación de Autoelevadores en Buenos Aires | PROMAQ';
const descripcion =
  'Reparación de autoelevadores en planta: mantenimiento preventivo, service hidráulico, frenos y transmisión. Buenos Aires y Entre Ríos. Cotizá hoy →';
const keywords =
  'reparacion de autoelevadores, service de autoelevadores en planta, mantenimiento preventivo de autoelevadores, arreglo de frenos y transmision autoelevador, service hidráulico para autoelevadores, reparación de autoelevadores combustión y eléctricos, auxilio mecánico autoelevadores';

const urlPagina = 'https://www.promaqmaquinas.com.ar/reparacion-autoelevadores/';

// Zonas de cobertura (mismo alcance que el Schema del negocio)
const zonasCobertura = [
  { '@type': 'City', name: 'Ciudad Autónoma de Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Norte del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Oeste del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Zona Sur del Gran Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Provincia de Buenos Aires' },
  { '@type': 'AdministrativeArea', name: 'Entre Ríos' },
  { '@type': 'Country', name: 'Argentina' },
];

// Schema adicional de esta página: Service (referencia al negocio
// por @id, inyectado por LayoutBase) + BreadcrumbList.
const schemaAdicional = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${urlPagina}#servicio`,
      name: 'Reparación y service de autoelevadores en Buenos Aires',
      serviceType: 'Reparación, mantenimiento preventivo y correctivo de autoelevadores',
      description:
        'Reparación de autoelevadores en planta y en taller: mantenimiento preventivo, service hidráulico, arreglo de frenos y transmisión, mástiles, cadenas e izaje, motores de combustión y eléctricos, y auxilio mecánico para industrias, logística y depósitos.',
      url: urlPagina,
      provider: { '@id': 'https://www.promaqmaquinas.com.ar/#negocio' },
      areaServed: zonasCobertura,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.promaqmaquinas.com.ar/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Reparación de autoelevadores',
          item: urlPagina,
        },
      ],
    },
  ],
};

// Trabajos de la sección principal (H2 de sección → H3 por tarjeta)
const trabajosReparacion = [
  {
    titulo: 'Mantenimiento preventivo de autoelevadores',
    descripcion:
      'Service programado con checklist: niveles, lubricación, frenos, transmisión, luces, batería y seguridad. Registro de trabajos para dejar la máquina trazada.',
    icono:
      '<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><polyline points="9 14 11 16 15 12"/>',
  },
  {
    titulo: 'Service hidráulico para autoelevadores',
    descripcion:
      'Diagnóstico y reparación del sistema hidráulico: bombas, cilindros, distribuidores y mangueras. Cambio de aceite hidráulico y ajuste de presiones.',
    icono: '<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>',
  },
  {
    titulo: 'Arreglo de frenos y transmisión de autoelevadores',
    descripcion:
      'Reparación de frenos, tambores, discos, pastillas, embragues, cajas de transmisión y diferenciales, con repuestos compatibles con tu modelo.',
    icono:
      '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
  },
  {
    titulo: 'Reparación de mástiles, cadenas e izaje',
    descripcion:
      'Mástiles, cadenas de elevación, horquillas, rodillos y cilindros de izaje: rectificado, ajuste de holguras y reemplazo de componentes con verificación de seguridad.',
    icono:
      '<line x1="5" y1="3" x2="5" y2="21"/><line x1="10" y1="7" x2="10" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/><line x1="3" y1="21" x2="21" y2="21"/><line x1="5" y1="8" x2="10" y2="8"/>',
  },
  {
    titulo: 'Reparación de motores de combustión',
    descripcion:
      'Service y reparación de autoelevadores diésel, nafta y GLP: motor, inyección, filtros de combustible gasoil, correas y sistema de enfriamiento.',
    icono:
      '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    titulo: 'Reparación de autoelevadores eléctricos',
    descripcion:
      'Motores eléctricos, cargadores, baterías y controles: diagnóstico de fallas, cambio de baterías y reparación del sistema eléctrico de a bordo.',
    icono:
      '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  },
  {
    titulo: 'Auxilio mecánico y service en planta',
    descripcion:
      'Atendemos máquinas detenidas en tu planta o depósito con prioridad, en CABA, GBA y Entre Ríos. Muchas fallas se resuelven en la misma visita.',
    icono:
      '<rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>',
  },
];

// Proceso de trabajo (H2 de sección → H3 por paso)
const pasosProceso = [
  {
    titulo: 'Consulta y diagnóstico',
    descripcion:
      'Nos escribís por WhatsApp, llamás o completás el formulario. Si la máquina está detenida, activamos auxilio mecánico para diagnosticar en tu planta.',
  },
  {
    titulo: 'Presupuesto previo',
    descripcion:
      'Informamos trabajos, repuestos y tiempos antes de comenzar. Aprobás el presupuesto de reparación y coordinamos la visita.',
  },
  {
    titulo: 'Reparación en planta o en taller',
    descripcion:
      'Trabajamos en tu planta o depósito para minimizar tiempos de parada; los trabajos de mayor envergadura se realizan en nuestro taller especializado.',
  },
  {
    titulo: 'Puesta a punto y entrega',
    descripcion:
      'Verificamos frenos, transmisión, hidráulica y seguridad, probamos la máquina y entregamos con el detalle de los trabajos realizados.',
  },
];

// FAQ: misma fuente para el acordeón visible y el schema FAQPage
const preguntasFrecuentes = [
  {
    pregunta: '¿Qué trabajos puedo hacer en mi planta y cuáles van al taller?',
    respuesta:
      'El service de autoelevadores en planta cubre mantenimiento preventivo, frenos, sistema hidráulico, eléctrica y fallas puntuales con repuesto en stock. Mástiles, rectificados, transmisiones completas y reparación de motor se realizan en nuestro taller especializado.',
  },
  {
    pregunta: '¿Qué incluye el mantenimiento preventivo de autoelevadores?',
    respuesta:
      'Revisión de frenos y transmisión, sistema hidráulico, niveles y estado del aceite, filtros de aire, aceite, combustible e hidráulicos, batería y luces, correas y mangueras, con registro de los trabajos realizados.',
  },
  {
    pregunta: '¿Reparan autoelevadores de combustión y eléctricos?',
    respuesta:
      'Sí. Reparamos autoelevadores diésel, nafta y GLP (motores de combustión) y autoelevadores eléctricos: motor, cargador, baterías y sistema de control.',
  },
  {
    pregunta: '¿Hacen arreglo de frenos, transmisión y service hidráulico?',
    respuesta:
      'Sí. Arreglamos frenos, embragues, transmisión y diferenciales, y damos service hidráulico para autoelevadores: bombas, cilindros, distribuidores y mangueras, con cambio de aceite hidráulico y ajuste de presiones.',
  },
  {
    pregunta: '¿Atienden urgencias y auxilio mecánico de autoelevadores?',
    respuesta:
      'Sí. Damos auxilio mecánico y service urgente para máquinas detenidas en Ciudad Autónoma de Buenos Aires, Zona Norte, Zona Oeste y Zona Sur del GBA, resto de la provincia de Buenos Aires y Entre Ríos. Respondemos por WhatsApp y teléfono.',
  },
  {
    pregunta: '¿Cómo pido un presupuesto de reparación de autoelevadores?',
    respuesta:
      'Por WhatsApp al +54 9 11 3207-7351, por correo a pro.maq@yahoo.com.ar o desde el formulario de contacto. Enviamos una evaluación y presupuesto previo sin compromiso.',
  },
];

// Schema FAQPage generado desde la misma fuente (garantiza el espejo 1:1)
const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntasFrecuentes.map((item) => ({
    '@type': 'Question',
    name: item.pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.respuesta,
    },
  })),
};

// Otros servicios (misma data que la home)
const otrosServicios = [
  {
    href: '/venta-de-filtros/',
    titulo: 'Venta de filtros industriales',
    descripcion:
      'Filtros de aire, aceite, combustible e hidráulicos, nacionales e importados, para autoelevadores y maquinaria pesada.',
    icono: '<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>',
  },
  {
    href: '/fabricacion-filtros-especiales/',
    titulo: 'Fabricación de filtros especiales',
    descripcion:
      'Filtros a medida sobre muestra, plano o medidas específicas para maquinaria fuera de estándar.',
    icono:
      '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
  },
  {
    href: '/venta-de-autoelevadores/',
    titulo: 'Venta de autoelevadores',
    descripcion:
      'Autoelevadores nuevos y usados seleccionados, reacondicionados con garantía. Diésel, nafta, GLP y eléctricos.',
    icono:
      '<rect x="3" y="6" width="7" height="10" rx="1"/><line x1="13" y1="3" x2="13" y2="16"/><line x1="13" y1="16" x2="19" y2="16"/><circle cx="6" cy="18.5" r="2"/><circle cx="16" cy="18.5" r="2"/>',
  },
  {
    href: '/alquiler-de-maquinaria/',
    titulo: 'Alquiler de maquinaria y autoelevadores',
    descripcion:
      'Renta por día, mes o largo plazo con mantenimiento incluido. Ideal para depósitos logísticos, obras y descarga de camiones.',
    icono:
      '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  },
];
---

<Layout title={titulo} description={descripcion} keywords={keywords} schemaFaq={schemaFaq} schemaAdicional={schemaAdicional}>

  <!-- ============ Hero Section ============ -->
  <section id="inicio" class="relative overflow-hidden border-b border-zinc-800 bg-slate-900 scroll-mt-24">
    <!-- Fondo: rejilla industrial + resplandor naranja -->
    <div class="fondo-rejilla degradado-hero absolute inset-0 opacity-40" aria-hidden="true"></div>
    <div class="absolute -top-32 right-0 h-96 w-96 rounded-full bg-orange-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-yellow-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
      <div class="max-w-4xl">

        <!-- Miga de pan visible (espejo del BreadcrumbList del schema) -->
        <nav aria-label="Miga de pan" class="mb-6 text-sm">
          <ol class="flex flex-wrap items-center gap-2 text-zinc-500">
            <li><a href="/" class="transition hover:text-orange-400">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-zinc-300" aria-current="page">Reparación de autoelevadores</li>
          </ol>
        </nav>

        <!-- Badge de respuesta rápida -->
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-yellow-500/30 bg-yellow-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-yellow-400">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-yellow-400"></span>
          </span>
          Service urgente en planta · Buenos Aires y Entre Ríos
        </p>

        <!-- H1 único y optimizado (keyword primaria de keywords.md §2) -->
        <h1 class="font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
          Reparación de <span class="text-orange-500">autoelevadores</span> en Buenos Aires
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
          Service de autoelevadores <strong class="font-semibold text-zinc-200">en planta, a domicilio o en taller especializado</strong>:
          mantenimiento preventivo, service hidráulico, arreglo de frenos y transmisión, mástiles e izaje, motores de
          combustión y eléctricos, con presupuesto previo y respuesta ágil para minimizar tus tiempos de parada.
        </p>

        <!-- CTAs de acción inmediata -->
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a href="https://wa.me/5491132077351?text=Hola%20Emmanuel%2C%20consulto%20por%20presupuesto%20para%20service%2Freparaci%C3%B3n%20de%20autoelevador." target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-3 rounded-xl bg-orange-500 px-8 py-4 text-base font-bold text-slate-900 shadow-xl shadow-orange-500/25 transition hover:-translate-y-0.5 hover:bg-orange-600 hover:text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Cotizar reparación por WhatsApp
          </a>
          <a href="#trabajos" class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-600 bg-zinc-800/60 px-8 py-4 text-base font-semibold text-zinc-100 transition hover:-translate-y-0.5 hover:border-yellow-500 hover:text-yellow-400">
            Ver trabajos que realizamos
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Bloque de confianza ============ -->
  <section id="ventajas" class="border-b border-zinc-800 bg-slate-950 py-16 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">¿Por qué confiar la reparación a PROMAQ MÁQUINAS?</h2>
      <p class="mt-2 max-w-2xl text-zinc-400">Cada reparación arranca con diagnóstico y presupuesto previo: sin sorpresas ni trabajo de más.</p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Diagnóstico antes de tocar la máquina</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Revisamos frenos, hidráulica, transmisión, mástil e izaje y te informamos qué necesita cada sistema antes de reparar.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Presupuesto previo por escrito</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Trabajos, repuestos y tiempos estimados antes de comenzar. Aprobás el presupuesto y recién ahí intervenimos.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">Repuestos y filtros para resolver en la visita</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Llevamos filtros y repuestos habituales a planta: muchas fallas quedan resueltas en la misma visita.</p>
        </div>

        <div class="rounded-2xl border border-zinc-700 bg-zinc-800/60 p-6 transition hover:border-orange-500/60">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
          </div>
          <h3 class="font-display text-lg font-bold text-white">+10 años reparando esta maquinaria</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">Más de una década con autoelevadores de la industria, la logística y los depósitos de Buenos Aires y Entre Ríos.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Trabajos de reparación (keywords long-tail) ============ -->
  <section id="trabajos" class="border-b border-zinc-800 bg-slate-900 py-20 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Reparación y servicio técnico</p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl font-bold leading-snug text-white sm:text-4xl">
        Mantenimiento preventivo y correctivo de autoelevadores
      </h2>
      <p class="mt-4 max-w-2xl text-zinc-400">
        Mecánica de maquinaria industrial aplicada a autoelevadores: desde el service programado hasta la reparación
        de componentes hidráulicos, eléctricos y de transmisión, con o sin detención de la máquina.
      </p>


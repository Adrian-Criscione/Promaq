</div>

<!-- ============ Header / Navbar sticky ============ -->
<header class="sticky top-0 z-40 border-b border-zinc-800 bg-slate-900/95 backdrop-blur">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3" aria-label="PROMAQ MÁQUINAS - Ir al inicio">
      <img src="/assets/images/logo.png" alt="PROMAQ MÁQUINAS" class="h-12 w-auto" onerror="this.style.display='none'">
      <span class="font-display text-lg font-extrabold leading-tight tracking-wide text-white sm:text-xl">
        PROMAQ <span class="text-orange-500">MÁQUINAS</span>
      </span>
    </a>

    <!-- Menú desktop -->
    <nav class="hidden items-center gap-8 lg:flex" aria-label="Menú principal">
      <a href="/" class="text-sm font-medium text-zinc-300 transition hover:text-orange-400">Inicio</a>

      <!-- Desplegable de servicios: 100% CSS (hover + focus), sin JavaScript -->
      <div class="group relative">
        <a href="/#servicios" class="flex items-center gap-1 text-sm font-medium text-zinc-300 transition hover:text-orange-400" aria-haspopup="true">
          Servicios
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="invisible absolute left-0 top-full w-72 rounded-xl border border-zinc-700 bg-zinc-800 p-2 opacity-0 shadow-2xl shadow-black/50 transition-all group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <a href="/reparacion-autoelevadores/" class="block rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-700 hover:text-orange-400">Service y reparación de autoelevadores</a>
          <a href="/venta-de-filtros/" class="block rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-700 hover:text-orange-400">Venta de filtros industriales</a>
          <a href="/fabricacion-filtros-especiales/" class="block rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-700 hover:text-orange-400">Fabricación de filtros especiales</a>
          <a href="/venta-de-autoelevadores/" class="block rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-700 hover:text-orange-400">Venta de autoelevadores</a>
          <a href="/alquiler-de-maquinaria/" class="block rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-700 hover:text-orange-400">Alquiler de maquinaria</a>
        </div>
      </div>

      <a href="/#preguntas-frecuentes" class="text-sm font-medium text-zinc-300 transition hover:text-orange-400">Preguntas frecuentes</a>
      <a href="/contacto/" class="text-sm font-medium text-zinc-300 transition hover:text-orange-400">Contacto</a>

      <a href="tel:+5491132077351" class="flex items-center gap-2 rounded-lg bg-orange-500 px-5 py-2.5 text-sm font-bold text-slate-900 shadow-lg shadow-orange-500/20 transition hover:bg-orange-600 hover:text-white">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Llamar: 11 3207-7351
      </a>
    </nav>

    <!-- Botón hamburguesa (menú móvil) -->
    <button id="menuToggle" type="button" class="rounded-lg border border-zinc-700 bg-zinc-800 p-2.5 text-zinc-200 transition hover:border-orange-500 hover:text-orange-400 lg:hidden" aria-controls="menuMovil" aria-expanded="false" aria-label="Abrir o cerrar el menú de navegación">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>

  <!-- Menú móvil (oculto por defecto; lo controla el script de este componente) -->
  <div id="menuMovil" class="hidden border-t border-zinc-800 bg-slate-900 lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6" aria-label="Menú móvil">
      <a href="/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-200 transition hover:bg-zinc-800 hover:text-orange-400">Inicio</a>
      <p class="px-3 pb-1 pt-3 text-xs font-bold uppercase tracking-widest text-zinc-500">Servicios</p>
      <a href="/reparacion-autoelevadores/" class="rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-800 hover:text-orange-400">Service y reparación de autoelevadores</a>
      <a href="/venta-de-filtros/" class="rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-800 hover:text-orange-400">Venta de filtros industriales</a>
      <a href="/fabricacion-filtros-especiales/" class="rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-800 hover:text-orange-400">Fabricación de filtros especiales</a>
      <a href="/venta-de-autoelevadores/" class="rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-800 hover:text-orange-400">Venta de autoelevadores</a>
      <a href="/alquiler-de-maquinaria/" class="rounded-lg px-3 py-2.5 text-sm text-zinc-300 transition hover:bg-zinc-800 hover:text-orange-400">Alquiler de maquinaria</a>
      <a href="/#preguntas-frecuentes" class="mt-3 rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-200 transition hover:bg-zinc-800 hover:text-orange-400">Preguntas frecuentes</a>
      <a href="/contacto/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-200 transition hover:bg-zinc-800 hover:text-orange-400">Contacto</a>
      <a href="tel:+5491132077351" class="mt-3 flex items-center justify-center gap-2 rounded-lg bg-orange-500 px-5 py-3 text-sm font-bold text-slate-900 transition hover:bg-orange-600 hover:text-white">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Llamar: 11 3207-7351
      </a>
    </nav>
  </div>
</header>

<!-- JS mínimo: solo menú móvil (misma lógica que js/main.js de la versión HTML estática) -->
<script>
  const menuToggle = document.getElementById('menuToggle');
  const menuMovil = document.getElementById('menuMovil');
  let isMenuOpen = false;

  function alternarMenu() {
    isMenuOpen = !isMenuOpen;
    menuMovil.classList.toggle('hidden', !isMenuOpen);
    menuToggle.setAttribute('aria-expanded', String(isMenuOpen));
  }

  if (menuToggle && menuMovil) {
    menuToggle.addEventListener('click', alternarMenu);

    // Cerrar el menú al tocar cualquiera de sus enlaces
    const enlacesMenu = menuMovil.querySelectorAll('a');
    enlacesMenu.forEach(function (enlace) {
      enlace.addEventListener('click', function () {
        if (isMenuOpen) {
          alternarMenu();
        }
      });
    });
  }
</script>

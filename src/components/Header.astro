<!-- ============ Barra superior de contacto rápido ============ -->
<div class="border-b border-zinc-800 bg-slate-950">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-2 text-xs sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
      <a href="tel:+5491132077351" class="flex items-center gap-1.5 text-zinc-400 transition hover:text-orange-400">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        +54 9 11 3207-7351
      </a>
      <a href="mailto:pro_maq@yahoo.com.ar" class="flex items-center gap-1.5 text-zinc-400 transition hover:text-orange-400">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        pro_maq@yahoo.com.ar
      </a>
    </div>
    <p class="flex items-center gap-1.5 text-zinc-500">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-yellow-400" aria-hidden="true"></span>
      Buenos Aires · GBA · Entre Ríos
    </p>

---
// ============================================================
// Tarjeta de servicio reutilizable (grid de la home y secciones
// relacionadas). El ícono SVG llega como string de sus paths.
// ============================================================
interface Props {
  href: string;
  titulo: string;
  descripcion: string;
  icono: string;
  ancho?: string;
}

const { href, titulo, descripcion, icono, ancho = '' } = Astro.props;
---

<article class:list={['group flex flex-col rounded-2xl border border-zinc-700 bg-zinc-800/70 p-7 transition hover:-translate-y-1 hover:border-orange-500', ancho]}>
  <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-orange-500/10 text-orange-400 transition group-hover:bg-orange-500 group-hover:text-slate-900">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icono}></svg>
  </div>
  <h2 class="font-display text-xl font-bold text-white">{titulo}</h2>
  <p class="mt-3 flex-1 leading-relaxed text-zinc-400">{descripcion}</p>
  <a href={href} class="mt-6 inline-flex items-center gap-2 font-semibold text-orange-400 transition group-hover:text-yellow-400">
    Ver más detalles y cotizar
    <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
  </a>
</article>
